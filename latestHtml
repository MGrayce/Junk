<!DOCTYPE html>
<html>
<head>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<title>C360 Portal</title>

<style>

*{
    font-family:Inter;
}

body{

    min-height:100vh;

    background:
    radial-gradient(
        circle at bottom,
        rgba(67,125,255,.8),
        transparent 35%
    ),
    linear-gradient(
        180deg,
        #f6f8fb,
        #edf2ff
    );

    display:flex;

    justify-content:center;

    align-items:center;

    padding:40px;

}

.main-card{

    width:1200px;

    min-height:720px;

    background:
    rgba(255,255,255,.70);

    backdrop-filter:blur(18px);

    border-radius:30px;

    padding:14px;

    box-shadow:
    0 30px 80px rgba(0,0,0,.08);

}

.left-panel{

    background:white;

    border-radius:24px;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:60px;

}

.right-panel{

    position:relative;

    border-radius:24px;

    overflow:hidden;

    background:

    linear-gradient(
        160deg,
        #edf6ff,
        #e5f1ff
    );

    padding:70px;

}

.badge-soft{

    display:inline-flex;

    align-items:center;

    padding:8px 18px;

    border-radius:30px;

    background:#eef9f1;

    color:#30a36b;

    font-size:13px;

}

.verify-box{

    width:100%;
    max-width:380px;

}

.otp{

    display:flex;

    gap:12px;

}

.otp input{

    width:60px;

    height:65px;

    text-align:center;

    border-radius:14px;

    border:1px solid #d7dff0;

}

.otp input:focus{

    outline:none;

    border:2px solid #377DFF;

}

.btn-c360{

    background:#377DFF;

    border:none;

    height:54px;

    border-radius:14px;

}

.shield{

    width:260px;

    height:260px;

    background:white;

    border-radius:28px;

    display:flex;

    justify-content:center;

    align-items:center;

    margin:auto;

    margin-top:50px;

    box-shadow:
    0 30px 60px rgba(0,0,0,.08);

}

.shield-icon{

    font-size:80px;

}

.float-card{

    position:absolute;

    background:white;

    padding:14px 20px;

    border-radius:16px;

    box-shadow:
    0 20px 40px rgba(0,0,0,.08);

}

.float1{

    right:50px;
    top:320px;

}

.float2{

    left:40px;
    bottom:180px;

}

.logo-pill{

    position:absolute;

    top:25px;

    padding:10px 22px;

    background:white;

    border-radius:50px;

}

.logo-left{

    left:30px;

}

.logo-right{

    right:30px;

}

.c360{

    color:#3786ff;

}

.subtitle{

    color:#7a8594;

}

@media(max-width:991px){

.right-panel{

display:none;

}

}

</style>

</head>

<body>

<div class="main-card">

<div class="row g-0 h-100">

<!-- LEFT -->

<div class="col-lg-6 left-panel">

<div class="verify-box">

<div class="text-center">

<div class="mb-4">

<div
style="
width:42px;
height:42px;
border-radius:14px;
background:#f3f6ff;
display:inline-flex;
align-items:center;
justify-content:center;
">

🛡️

</div>

</div>

<h1 class="fw-semibold">

Portal Access

</h1>

<p class="subtitle">

Secure access to customer intelligence

</p>

</div>

<label class="mt-4 mb-2">

Verification Code

</label>

<div class="otp">

<input maxlength="1">
<input maxlength="1">
<input maxlength="1">
<input maxlength="1">
<input maxlength="1">
<input maxlength="1">

</div>

<div class="d-flex justify-content-between mt-3">

<a href="#">
Resend Code
</a>

<small class="subtitle">

2FA Enabled

</small>

</div>

<button
class="btn btn-primary btn-c360 w-100 mt-4">

Enter Portal

</button>

<div
class="text-center mt-5">

<small class="subtitle">

Protected • Secure • Internal Use

</small>

</div>

</div>

</div>


<!-- RIGHT -->

<div class="col-lg-6 right-panel">

<div class="badge-soft">

ACTIVE SESSION

</div>

<h1
class="display-4 fw-bold mt-4">

Customer Intelligence
<span class="c360">

360°

</span>

</h1>

<p class="subtitle">

Search customers, view accounts,
transactions, loans and profiles
through one unified experience.

</p>

<div class="shield">

<div class="text-center">

<div class="shield-icon">

🛡️

</div>

<h4>

Secure Workspace

</h4>

<small class="c360">

End-to-End Protected

</small>

</div>

</div>

<div class="float-card float1">

✔ Session Verified

</div>

<div class="float-card float2">

📁 Unified Profiles

</div>

</div>

</div>

</div>

</body>

</html>