<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>C360 Login</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{
    background:#234e78;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:Segoe UI;
}

.login-wrapper{
    width:1150px;
    min-height:700px;
    background:#eef0f4;
    border-radius:32px;
    overflow:hidden;

    box-shadow:
    0 30px 80px rgba(0,0,0,.15);
}

.left-panel{
    background:linear-gradient(
        145deg,
        #4B79F8,
        #3E72ED
    );

    position:relative;
    padding:45px;

    color:white;
}

.dashboard-preview{
    background:white;

    border-radius:22px;

    padding:20px;

    margin-top:40px;

    box-shadow:
    0 20px 50px rgba(0,0,0,.12);
}

.floating-card{
    position:absolute;

    background:white;

    color:#222;

    padding:14px;

    border-radius:16px;

    width:180px;

    box-shadow:
    0 12px 30px rgba(0,0,0,.15);
}

.card-top{
    top:90px;
    left:35px;
}

.card-bottom{
    bottom:170px;
    right:60px;
}

.right-panel{
    background:#f7f8fa;

    padding:90px 70px;

    display:flex;

    align-items:center;
}

.auth-box{
    width:100%;
}

.tab-box{
    background:#eceff5;

    border-radius:40px;

    padding:4px;

    display:flex;

    margin-bottom:40px;
}

.tab-btn{
    flex:1;

    border:none;

    background:none;

    padding:12px;

    border-radius:40px;

    font-weight:600;
}

.active-tab{
    background:white;

    box-shadow:
    0 4px 14px rgba(0,0,0,.08);
}

.form-control{
    height:58px;

    border-radius:18px;

    border:1px solid #ddd;
}

.login-btn{

    background:#4B79F8;

    color:white;

    height:56px;

    border:none;

    border-radius:50px;

    width:100%;

    font-weight:600;
}

.social-btn{
    height:56px;

    border-radius:50px;

    background:white;

    border:1px solid #ddd;

    margin-top:15px;

    width:100%;
}

.footer{
    margin-top:80px;

    display:flex;

    justify-content:space-between;

    color:#777;

    font-size:14px;
}

</style>

</head>

<body>

<div class="container">

<div class="login-wrapper row g-0">

    <!-- LEFT -->

    <div class="col-lg-6 left-panel">

        <div class="floating-card card-top">
            <small>Total Income</small>
            <h3>$17,500</h3>
            <small>vs last month</small>
        </div>

        <div class="dashboard-preview">

            <img src="https://placehold.co/700x350"
                 class="img-fluid rounded">

        </div>

        <div class="text-center mt-5">

            <h1 class="fw-bold">
                Stay Balanced.
                Live Smarter.
            </h1>

            <p class="mt-3">
                C360 helps keep customer data visible,
                searchable and easy to manage.
            </p>

        </div>

        <div class="floating-card card-bottom">
            <small>Total Balance</small>
            <h3>$20,000</h3>
            <small>20% better this month</small>
        </div>

    </div>


    <!-- RIGHT -->

    <div class="col-lg-6 right-panel">

        <div class="auth-box">

            <h1 class="fw-bold text-center">
                Hi, Welcome 👋
            </h1>

            <div class="tab-box mt-4">
                <button class="tab-btn active-tab">
                    Sign In
                </button>

                <button class="tab-btn">
                    Sign Up
                </button>
            </div>

            <div class="mb-4">

                <label class="fw-semibold mb-2">
                    Email address
                </label>

                <input
                    type="email"
                    class="form-control"
                    placeholder="Your email">

            </div>

            <div>

                <label class="fw-semibold mb-2">
                    Password
                </label>

                <input
                    type="password"
                    class="form-control"
                    placeholder="Password">

            </div>

            <div
            class="d-flex
            justify-content-between
            mt-3">

                <div>
                    <input type="checkbox">
                    Remember me
                </div>

                <a href="#">
                    Forgot password?
                </a>

            </div>

            <button
            class="login-btn mt-4">

                Log In

            </button>

            <hr class="my-5">

            <button class="social-btn">
                Continue with Google
            </button>

            <button class="social-btn">
                Continue with Apple
            </button>

            <div class="footer">

                <span>
                    Privacy Policy
                </span>

                <span>
                    © C360 2026
                </span>

            </div>

        </div>

    </div>

</div>

</div>

</body>

</html>